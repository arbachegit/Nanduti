# =============================================================
# Ñandutí MVP — variáveis de ambiente
# Copie este arquivo para .env.local e preencha. .env.local nunca
# vai pro git (.gitignore já cobre).
# =============================================================

# -------- LLM (DigitalOcean Gradient AI — único provedor MVP)
# "Manage Model Access Keys" no painel DO. SDK usa a interface
# Anthropic, mas aponta a base URL pro DO Inference.
DO_INFERENCE_BASE_URL=
DO_INFERENCE_KEY=
LLM_MODEL_FAST=anthropic-claude-3.5-haiku
LLM_MODEL_DEEP=anthropic-claude-sonnet-4

# -------- LLM dev local opcional (Anthropic direto)
# Quando setado, sobrescreve DO_INFERENCE_* localmente.
ANTHROPIC_API_KEY=

# -------- TTS / STT (produção)
OPENAI_API_KEY=

# -------- Supabase (banco iconsai-nanduti)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# -------- Cache (opcional; in-memory fallback se ausente)
REDIS_URL=

# -------- SMS / WhatsApp OTP (Infobip — canônico ecossistema)
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_SENDER=

# -------- Email transacional (opcional, Resend canônico)
RESEND_API_KEY=

# -------- Fontes Paraguai com auth
DNIT_API_KEY=
RELIEFWEB_APPNAME=nanduti.iconsai.ai

# -------- Modo demo (mantém persona María González em apresentações)
# Quando true, auth.cic_otp aceita CIC 4521846 + OTP 123456 sem Infobip.
DEMO_MODE=true

# -------- BUILD_ID (stamp para anti-deploy-fantasma)
BUILD_ID=
