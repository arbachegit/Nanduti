# Anthropic Claude (orchestrator + tool dispatch). Falls back to deterministic
# intent router when missing.
ANTHROPIC_API_KEY=

# OpenAI (TTS / Whisper STT in production). The mockup uses local fakes when
# this is missing.
OPENAI_API_KEY=

# ElevenLabs (production voice "Ana" es-PY). Mockup uses no voice synthesis
# in browser; production should plug ElevenLabs here.
ELEVENLABS_API_KEY=

# Redis (orchestrator cache; 300s TTL). Falls back to in-memory map when missing.
REDIS_URL=
